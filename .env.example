# UseGoodAI server-side credentials
USEGOODAI_API_KEY=
USEGOODAI_REASONING_API_KEY=
USEGOODAI_REASONING_MODEL=gpt-5.5

# Railway only: Cloudflare R2 S3-compatible storage
R2_ACCOUNT_ID=
